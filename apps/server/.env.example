# openICQ server. Copy to .env and adjust; every variable is optional.

# Port to listen on. 5190 is the classic ICQ/OSCAR port.
PORT=5190
# Interface to bind. Keep 127.0.0.1 unless a reverse proxy runs on another host.
HOST=127.0.0.1
# SQLite file (the directory is created). Use :memory: for a throwaway database.
DATABASE_PATH=./data/openicq.db
# Uploaded files. Defaults to a "files" folder next to the database.
# FILES_DIR=./data/files
# Largest accepted upload in bytes (default 100 MB).
MAX_FILE_BYTES=104857600
# Bytes of files one user may keep stored (default 2 GB). Uploads past it get too_large.
MAX_USER_STORAGE_BYTES=2147483648
# Bytes of files all users may keep stored together. 0 (the default) means no cap.
MAX_TOTAL_STORAGE_BYTES=0
# First ICQ number handed out at registration; numbers are sequential from here.
UIN_START=100000
# Comma separated origins allowed to call state-changing routes and open the WebSocket.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5190,http://localhost:5190
# Set to true when served over HTTPS, so the session cookie gets the Secure flag.
COOKIE_SECURE=false
# Client build served with SPA fallback when it exists (relative to this directory).
CLIENT_DIST_DIR=../client/dist
# fatal, error, warn, info, debug, trace or silent. debug logs every WebSocket request.
LOG_LEVEL=info
