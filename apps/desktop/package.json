{
  "name": "@openicq/desktop",
  "productName": "openICQ",
  "version": "1.0.0",
  "private": true,
  "description": "openICQ: a faithful, open-source rebuild of the classic ICQ 2001b messenger for Windows, macOS and Linux.",
  "author": {
    "name": "Sahar Hazan",
    "email": "saharhazan@users.noreply.github.com"
  },
  "homepage": "https://github.com/saharhazan/openICQ",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "pnpm --filter @openicq/client build && node scripts/build.mjs",
    "icons": "node scripts/make-icons.mjs",
    "start": "pnpm run build && electron .",
    "dist": "pnpm run build && electron-builder --publish never",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "98.css": "0.1.21",
    "@openicq/client": "workspace:*",
    "@openicq/desktop-bridge": "workspace:*",
    "@openicq/protocol": "workspace:*",
    "@openicq/server": "workspace:*",
    "@types/node": "26.6.5",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
